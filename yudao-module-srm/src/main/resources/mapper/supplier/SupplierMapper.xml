<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.iocoder.yudao.module.srm.dal.mysql.supplier.SupplierMapper">

    <!-- 框架自动加 tenant_id、deleted，这里不需要写 -->
    <select id="selectPageByCompanyId"
            resultType="cn.iocoder.yudao.module.srm.dal.dataobject.supplier.SupplierDO">
        SELECT *
        FROM srm_supplier
        WHERE company_id = #{companyId}
        ORDER BY id DESC

    </select>

</mapper>